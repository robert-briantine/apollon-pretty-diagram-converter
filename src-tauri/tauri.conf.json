{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diagrammes",
  "version": "0.1.0",
  "identifier": "fr.diagrammes.activite",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Diagrammes d’activité", "width": 1440, "height": 960, "minWidth": 360, "minHeight": 500 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; worker-src 'self'; connect-src ipc: http://ipc.localhost blob:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "shortDescription": "Diagrammes Appolon JS vers SVG",
    "category": "GraphicsAndDesign",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "languages": ["French", "English"], "displayLanguageSelector": true } }
  }
}
